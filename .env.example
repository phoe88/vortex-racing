# ─── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Never prefix with NEXT_PUBLIC_, never commit a real value.
# Used by the seed script and by server actions that must bypass RLS
# (newsletter sign-ups, admin bootstrap).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Site ────────────────────────────────────────────────────────────────────
# Canonical URL used for metadata, Open Graph images and the sitemap.
# On Vercel this falls back to VERCEL_PROJECT_PRODUCTION_URL automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret for POST /api/revalidate (on-demand cache purge from webhooks).
REVALIDATE_SECRET=change-me

# ─── Seed script only (pnpm seed) ────────────────────────────────────────────
# Optional: creates/promotes this user to the admin role while seeding.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
